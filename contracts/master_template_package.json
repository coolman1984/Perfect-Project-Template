    "__pycache__",
    ".pytest_cache",
    "node_modules"
  ],
  "forbidden_source_suffixes": [
    ".xlsx",
    ".xlsm",
    ".xlsb",
    ".xls",
    ".duckdb",
    ".parquet",
    ".log"
  ]
}
