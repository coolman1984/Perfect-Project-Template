root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,json,css,html,yaml,yml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows launchers must keep CRLF or cmd.exe mis-parses them.
[*.bat]
end_of_line = crlf
